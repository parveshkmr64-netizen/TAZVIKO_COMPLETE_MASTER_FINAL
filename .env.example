PORT=8000
TAZVIKO_ADMIN_KEY=replace-with-a-long-random-admin-key
TAZVIKO_DB_PATH=./data/tazviko.sqlite3
# Set this to the final HTTPS site origin, e.g. https://tazviko.com
PUBLIC_BASE_URL=
# Leave blank for COD-only launch. Add Razorpay keys to enable UPI/Card online checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Pricing controls (paise are not used; values are INR rupees except BPS).
TAZVIKO_COMMISSION_BPS=1500
TAZVIKO_PLATFORM_FEE=9
TAZVIKO_DELIVERY_FEE=29
TAZVIKO_TAX_BPS=500
TAZVIKO_RATE_LIMIT=120

# Optional: enables automatic nearby restaurant/shop/mall discovery.
# Create a Google Maps Platform key with Places API (New) enabled and restrict the key.
GOOGLE_PLACES_API_KEY=
